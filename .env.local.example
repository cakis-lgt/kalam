# OpenAI Whisper (transkripsi) + Anthropic Claude (penilaian CEFR)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Penilaian otomatis AI (transkrip + assess + finalize). Default: mati (penilaian manual penguji).
# Set true setelah API key & billing siap:
# NEXT_PUBLIC_AI_SCORING_ENABLED=true

# Mode demo mock (hanya jika AI_SCORING_ENABLED=true):
# TRANSCRIBE_DEV_MOCK=true
# ASSESS_DEV_MOCK=true

# ── Supabase (wajib untuk auth, DB, storage) ─────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service role — HANYA server (seed demo, signed URL video). Jangan pakai NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Salin URI persis dari Dashboard → Connect → Transaction pooler (region bisa berbeda per project)
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Setelah mengisi file ini:
#   1. Bootstrap schema: npm run bootstrap:supabase  (atau paste scripts/kalam-bootstrap.sql di SQL Editor)
#   2. Seed akun demo: npm run seed:demo
#   3. Restart: npm run dev
#   4. Login demo di /login (Peserta / Penguji / Admin)
